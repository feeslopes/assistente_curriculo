# Copie este arquivo para ".env" (sem o .example) e preencha.
# O arquivo .env fica só no seu computador e nunca vai para o GitHub.

# Provedor: gemini | deepseek | openrouter
PROVEDOR=gemini

# Cole a chave do provedor escolhido (só a linha do provedor que você usa).
# Gemini (plano gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek (pago, bem barato): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenRouter (modelos gratuitos têm sufixo ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcional: nome do modelo. Se ficar vazio, usa o padrão do provedor:
#   gemini     -> gemini-3.8-flash (tem camada gratuita, confirmado em 12/10/2026)
#   deepseek   -> deepseek-flash   (não use deepseek-chat nem deepseek-reasoner, descontinuados)
#   openrouter -> sem padrão: escreva aqui um modelo com sufixo ":free"
# Os nomes mudam com o tempo. Para ver os que a sua chave enxerga: python verificar.py --modelos
MODELO=

# Opcional: pasta onde fica a base de conhecimento (padrão: ./base)
# CV_BASE_DIR=
