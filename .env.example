# Copie este arquivo para ".env" (sem o .example) e preencha.
# O arquivo .env fica só no seu computador e nunca vai para o GitHub.

# Provedor de IA usado pelo aplicativo.
PROVEDOR=deepseek

# Cole a chave do DeepSeek logo depois do "=", sem espaços e sem aspas.
# Para criar uma: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Deixe vazio para usar o modelo padrão (deepseek-flash). Só preencha se quem passou a chave pedir.
MODELO=

# Opcional: pasta onde fica a base de conhecimento (padrão: ./base)
# CV_BASE_DIR=

# ----------------------------------------------------------------------------------------------
# Modo hospedado (servidor). Só preencha no servidor, em /etc/assistente.env (permissão 600).
# Passo a passo em docs/MVP_HOSPEDADO.md. No seu computador, deixe tudo isto comentado.
# ----------------------------------------------------------------------------------------------
# CV_MODO=hospedado
# Pasta dos dados dos usuários e do banco de acesso (fora do código, em disco criptografado).
# CV_DADOS_DIR=/var/lib/assistente
# Segredo longo e aleatório (mínimo 32 caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# CV_SEGREDO=
# Endereço público do site, sem barra no fim.
# CV_URL_PUBLICA=https://app.seudominio.com.br
# 1 quando o servidor está atrás do Caddy (lê o IP real do cabeçalho X-Forwarded-For).
# CV_CONFIAR_PROXY=1
# Versão dos termos: ao mudar, todos os usuários precisam aceitar de novo.
# CV_VERSAO_TERMOS=2026-10-28
# E-mail de contato para privacidade, exibido nos Termos (opcional; sem ele vale o WhatsApp da contratação).
# CV_EMAIL_CONTATO=privacidade@seudominio.com.br

# Landing page: contratação pelo WhatsApp (só dígitos, com DDI e DDD) e preços exibidos.
# WHATSAPP_NUMERO=5511999999999
# PRECO_SEMANAL=7
# PRECO_MENSAL=15
# NOME_PRODUTO=Assistente Currículo

# Envio do link de acesso por e-mail (qualquer serviço SMTP transacional). Sem isto, o link não é enviado.
# SMTP_HOST=
# SMTP_PORTA=587
# SMTP_USUARIO=
# SMTP_SENHA=
# SMTP_REMETENTE=Assistente Currículo <acesso@seudominio.com.br>

# Câmbio usado para estimar o custo da IA em reais nos relatórios (padrão 5,5).
# CV_CAMBIO_BRL=5.5
